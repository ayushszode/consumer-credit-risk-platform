# Loan data never goes in the repository
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained models are rebuilt with the pipeline, except the published one used by the live app
# (models, settings and median values only: no loan records)
artifacts/*
!artifacts/.gitkeep
!artifacts/model_bundle.joblib

__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/
.env
.DS_Store
.ipynb_checkpoints/
.streamlit/secrets.toml

# IDE / editor
.idea/
.vscode/

# Test and coverage files
.coverage
htmlcov/
*.log
