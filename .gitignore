*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/
.env
.DS_Store
.ipynb_checkpoints/
.streamlit/secrets.toml

# IDE / editor
.idea/
.vscode/

# Test and coverage files
.coverage
htmlcov/
*.log
